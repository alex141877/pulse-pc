{
  "name": "pulsepc-desktop",
  "productName": "PulsePC",
  "version": "2.1.0",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "42.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.pulsepc.desktop",
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "artifactName": "PulsePC-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "alex141877",
      "repo": "pulse-pc"
    }
  }
}
